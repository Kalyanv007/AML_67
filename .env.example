# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini", "openai", "groq", or "ollama". Leave blank / omit key to run on the regex fallback.
# "ollama" runs fully locally (no key, no quota) — see OLLAMA_SETUP_MAC.md for Mac setup, or on Windows:
# install from https://ollama.com/download, then `ollama pull qwen2.5:7b-instruct`.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Only needed if not using the defaults (http://localhost:11434 / qwen2.5:7b-instruct):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# How long to keep the model in VRAM between calls (prevents cold-start reload).
# OLLAMA_KEEP_ALIVE=30m
# Per-call LLM timeout in seconds. 60s suits local Ollama 14B; 10s is fine for hosted APIs.
# LLM_TIMEOUT_SECONDS=60

# Use mock tools instead of Track B's real tools (1 = mocks, 0 = real).
# Real tools now exist (Phase 6) — use 0 for the actual demo. Mocks are only
# for developing the agent core in isolation, per WORKPLAN.md.
AML_USE_MOCKS=0

# Path to the working dataset (canonical-schema CSV). Also used by
# backend.agent.intent_parser to anchor relative dates ("last 30 days") to
# the dataset's own max date instead of wall-clock time.
AML_DATASET_PATH=data/sample/aml_sample.csv

# Backend API URL, read by frontend/app.py (variable name must be exactly
# AML_API_URL — that's what the Streamlit app actually reads).
AML_API_URL=http://localhost:8000
