# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" or "openai". Leave blank / omit key to run on the regex fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Use mock tools instead of Track B's real tools (1 = mocks, 0 = real).
# Track A should develop with this set to 1 until Track B's tools land at H24.
AML_USE_MOCKS=1

# Path to the working dataset (canonical-schema CSV).
AML_DATASET_PATH=data/sample/aml_sample.csv

# Backend API base URL, used by the Streamlit frontend.
AML_API_BASE_URL=http://localhost:8000
